<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>

<main class="container">
    <h1><%= title %></h1>

    <div class="content-box">
        <h2>Get in Touch</h2>

        <p>
            Connect with me on LinkedIn or explore
            my projects on GitHub.
        </p>

        <p>
            <a href="https://www.linkedin.com/in/ammar-syed-89a84b271/">
                LinkedIn Profile
            </a>
        </p>

        <p>
            <a href="https://github.com/ammarsyed312">
                GitHub Profile
            </a>
        </p>
    </div>

    <div class="content-box">
        <h2>Contact Form Demonstration</h2>

        <p>
Please fill your information below to get in contact with me
        </p>

        <p><%= feedback %></p>

        <form action="/contactme" method="post">
            <label for="contact-name">Name</label>
            <input
                type="text"
                id="contact-name"
                name="name"
            >

            <label for="contact-email">Email</label>
            <input
                type="email"
                id="contact-email"
                name="email"
            >

            <label for="contact-message">Message</label>
            <textarea
                id="contact-message"
                name="message"
            ></textarea>

            <button type="submit">Submit</button>
        </form>
    </div>
</main>

<%- include partials/footer.ejs %>